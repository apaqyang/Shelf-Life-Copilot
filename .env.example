# ---------------------------------------------------------------------------
# LLM provider — pick ONE based on --provider in CLI / make targets.
# ---------------------------------------------------------------------------

# Anthropic Claude (default; --provider anthropic)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Moonshot / KIMI (--provider moonshot)
# Get one from https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=sk-xxxxx

# 本地 OpenAI-compatible 服务（--provider local）
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=local-model
LOCAL_LLM_API_KEY=local

# ---------------------------------------------------------------------------
# 企业微信
# ---------------------------------------------------------------------------

# 路径 A：群机器人 webhook（v0.1 自测推荐 — 群主即可创建，不需管理员）
# 创建方式：企微群 → 设置 → 群机器人 → 添加 → 复制 Webhook 地址
# CLI 用法：python -m src.cli --customer customerA --push-webhook "$WECOM_WEBHOOK_URL"
# 或者：设了此 env 后，CLI 不带 --push-webhook 也会自动真推
WECOM_WEBHOOK_URL=

# 路径 B：自建应用 + 回调（v0.5 真实工单链路时启用，需要管理员权限 + 公网回调）
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TEST_GROUP_ID=

# ---------------------------------------------------------------------------
# 应用配置（长跑服务 src/main.py 读这些；uvicorn 启动自动挂调度器）
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# 静态兼容模式的 Bearer token；生产建议使用下方 OIDC。
API_TOKEN=
API_TOKEN_CUSTOMERS=customerA,customerB

# 生产可切换到 OIDC JWT（需安装 `.[oidc]`）。
AUTH_MODE=static
# OIDC_ISSUER=https://identity.example/realms/shelf-life
# OIDC_AUDIENCE=shelf-life-api
# OIDC_JWKS_URL=https://identity.example/realms/shelf-life/protocol/openid-connect/certs
# OIDC_CUSTOMER_CLAIM=customer_ids
# OIDC_ROLE_CLAIM=roles

# 回调重放窗口、POST 请求体上限和单实例滑动窗口限流。
WEBHOOK_REPLAY_WINDOW_SECONDS=300
MAX_REQUEST_BODY_BYTES=65536
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
SCAN_CONCURRENCY=4
TASK_QUEUE_ENABLED=true
TASK_WORKER_MAX_ATTEMPTS=3
TASK_WORKER_POLL_SECONDS=0.2
TASK_VISIBILITY_TIMEOUT_SECONDS=300

# ── 持久化 ──────────────────────────────────────────────────────────────
PERSISTENCE_BACKEND=sqlite
DECISIONS_DB_PATH=data/decisions.db
# PostgreSQL 生产切换：安装 `.[postgres]` 后设置下列配置。
# POSTGRES_DSN=postgresql://user:password@db:5432/shelf_life
# POSTGRES_POOL_MIN_SIZE=1
# POSTGRES_POOL_MAX_SIZE=10
REPORTS_OUTPUT_DIR=docs/demo_samples

# ── ERP 数据源：json 或 SAP Business One Service Layer ──
ERP_BACKEND=json
# SAP_B1_BASE_URL=https://sap.example
# SAP_B1_SESSION_COOKIE=B1SESSION=...; ROUTEID=.node1
# 推荐使用原子替换的 Cookie 文件，运行时每次请求重读，无需重启轮换。
# SAP_B1_SESSION_COOKIE_FILE=/run/secrets/sap-session-cookie
# SAP_B1_QUERY_CODE=ShelfLifeBatches
# SAP_B1_PAGE_SIZE=100
# SAP_B1_TIMEOUT_SECONDS=10
# SAP_B1_MAX_RETRIES=2

# ── 可观测性（需安装 `.[observability]`）──
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_SERVICE_NAME=shelf-life-copilot

# ── 每日扫描 cron（DailyScheduler）──────────────────────────────────────
SCAN_CUSTOMERS=customerA,customerB
SCAN_HOUR=7
SCAN_MINUTE=0

# ── 月度报告 cron（按客户 business_timezone 解释）────────────
MONTHLY_DAY=1
MONTHLY_HOUR=8
MONTHLY_MINUTE=0

# ── LLM 选择（缺 key 时 DailyScheduler 跳过，monthly/webhook 仍跑）──
LLM_PROVIDER=anthropic
